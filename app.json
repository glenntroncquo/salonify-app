{
  "expo": {
    "name": "Gleami",
    "slug": "gleami",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gleami",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gleami.staff",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gleami.staff",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1220",
          "dark": {
            "backgroundColor": "#0B1220"
          }
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set a profile picture."
        }
      ],
      "expo-localization",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "gleami",
          "project": "gleami",
          "note": "Use SENTRY_AUTH_TOKEN env to authenticate with Sentry. Do not put the token here."
        }
      ]
    ],
    "extra": {
      "sentryDsn": "https://f538d29e8552491263993c60be9477d0@o4512034656813056.ingest.de.sentry.io/4512034662580304",
      "sentryEnvironment": "development",
      "privacyUrl": "https://booking.salonify.co/privacy",
      "termsUrl": "https://booking.salonify.co/terms",
      "router": {},
      "eas": {
        "projectId": "0697a847-cb88-4e7c-b337-5641523fc443"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "glennt"
  }
}
